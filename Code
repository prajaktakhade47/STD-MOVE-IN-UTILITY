#include <iostream>
#include <string>
#include <vector>
#include <utility>      // for std::move
using namespace std;

class Dataset {
public:
    int *data;
    int size;

    Dataset(int n) {
        size = n;
        data = new int[n];
        for (int i = 0; i < n; i++) data[i] = i + 1;
    }

    // Copy constructor: makes a new copy of the data
    Dataset(const Dataset &other) {
        size = other.size;
        data = new int[size];
        for (int i = 0; i < size; i++) data[i] = other.data[i];
        cout << "Copy constructor called\n";
    }

    // Move constructor: takes the data from the other object
    Dataset(Dataset &&other) {
        size = other.size;
        data = other.data;
        other.data = nullptr;
        other.size = 0;
        cout << "Move constructor called\n";
    }

    ~Dataset() { delete[] data; }
};

int main() {
    cout << "--- 1. Copy vs Move ---\n";
    Dataset d1(5);
    Dataset d2 = d1;              // copy
    Dataset d3 = move(d1);        // move
    cout << "d1 size = " << d1.size << "\n";
    cout << "d2 size = " << d2.size << "\n";
    cout << "d3 size = " << d3.size << "\n";

    cout << "\n--- 2. std::move with string ---\n";
    string a = "Machine Learning";
    string b = move(a);
    cout << "a = \"" << a << "\"\n";
    cout << "b = \"" << b << "\"\n";

    cout << "\n--- 3. std::move with vector ---\n";
    vector<int> v1 = {1, 2, 3, 4, 5};
    vector<int> v2 = move(v1);
    cout << "v1 size = " << v1.size() << "\n";
    cout << "v2 size = " << v2.size() << "\n";

    return 0;
}
